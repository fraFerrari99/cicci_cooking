# Copia in `.env` (gitignored) e adatta. In produzione le stesse variabili vanno su Vercel.

# dev | test | prod. In prod: DEBUG=false, log JSON, Swagger disattivato.
ENV=dev

# Opzionali: se assenti derivano da ENV.
# DEBUG=true
# LOG_LEVEL=DEBUG

# Origini del frontend ammesse da CORS, separate da virgola.
CORS_ORIGINS=http://localhost:3000

# Non ancora usato (task "Database layer"). Con docker compose l'host diventa `db`.
DATABASE_URL=postgresql+asyncpg://cicci:cicci@localhost:5432/cicci
